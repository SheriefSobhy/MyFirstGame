; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Last Stand"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://settings.gd"
Music="*res://music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/autobake/plugin.cfg")

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
release_mouse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
weapon_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
weapon_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
weapon_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
weapon_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}
weapon_5={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":53)]
}
weapon_6={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":54)]
}
weapon_7={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":55)]
}
weapon_8={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":56)]
}
grenade={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
weapon_next={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
weapon_prev={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=1

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.desktop_forward_plus="forward_plus"
